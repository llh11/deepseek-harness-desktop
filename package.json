{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "1.5.4",
  "description": "把官方 DeepSeek Harness 的本地 Web UI 带到原生桌面。应用自动启动和管理本地 Harness 服务，集成系统托盘与桌面窗口，无需安装 Node.js 或执行命令。",
  "author": "DeepSeek Harness Desktop",
  "license": "MIT",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "gen:icons": "electron scripts/gen-icons.js",
    "dist": "node scripts/sync-engine.js && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.deepseek.dsh.desktop",
    "productName": "DeepSeek Harness Desktop",
    "directories": {
      "output": "release-1_5_4"
    },
    "files": [
      "main/**",
      "preload.js",
      "renderer/**",
      "assets/**",
      "package.json",
      "LICENSE*"
    ],
    "asarUnpack": [
      "main/lib/official-usage-scan.js"
    ],
    "extraResources": [
      {
        "from": "dsh-service",
        "to": "dsh-service"
      },
      {
        "from": "node-runtime",
        "to": "node-runtime"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DeepSeek Harness",
      "differentialPackage": false
    }
  },
  "allowScripts": {}
}
